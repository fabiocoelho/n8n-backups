        "jsCode": "// 1. Puxa o telefone original que veio do gatilho\nconst telefone = $('When Executed by Another Workflow').first().json.telefone;\n\n// 2. Procura em todas as 20 reuniões do Google qual delas contém o telefone\nconst match = $input.all().find(item => {\n  const text = JSON.stringify(item.json);\n  return text.includes(telefone);\n});\n\n// 3. Se achou a reunião, manda ela pra frente. Se não achou, manda o pacote vazio.\nif (match) {\n  return [match];\n} else {\n  return [{ json: {} }];\n}"
