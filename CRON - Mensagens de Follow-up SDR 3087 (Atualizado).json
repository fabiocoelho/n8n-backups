    {
      "parameters": {
        "jsCode": "const results = [];\nconst today = new Date();\ntoday.setHours(0,0,0,0);\n\nfor (const item of $input.all()) {\n// Trava de segurança: Pula o lead se o atendimento humano estiver ativado\n  if (item.json.ai_paused === true) continue;  \n  \n  // Lê a data da última interação blindada (ou usa o updated_at como plano B para leads velhos)\n  const lastUpdate = new Date(item.json.last_interaction_at || item.json.updated_at);\n  lastUpdate.setHours(0,0,0,0);\n  \n  const diffTime = Math.abs(today - lastUpdate);\n  const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));\n  \n  const etapaAtual = item.json.etapa_followup || 0;\n  let diaGatilho = 0;\n\n  // Lógica \"À prova de pulos\": Verifica a próxima etapa pendente se os dias já tiverem passado\n  if (etapaAtual < 2 && diffDays >= 2) diaGatilho = 2;\n  else if (etapaAtual < 3 && diffDays >= 3) diaGatilho = 3;\n  else if (etapaAtual < 4 && diffDays >= 4) diaGatilho = 4;\n  else if (etapaAtual < 7 && diffDays >= 7) diaGatilho = 7;\n  else if (etapaAtual < 10 && diffDays >= 10) diaGatilho = 10;\n\n  if (diaGatilho > 0) {\n    item.json.followup_dia = diaGatilho; // Avisa o roteador qual etapa disparar\n    results.push(item);\n  }\n}\nreturn results;"
      },
      "name": "Calcular 2, 3, 4, 7 e 10 Dias",
      "type": "n8n-nodes-base.code",
