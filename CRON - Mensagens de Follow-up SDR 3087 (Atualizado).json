      "parameters": {
        "jsCode": "const hoje = $now.setZone('America/Sao_Paulo');\nconst isDomingo = hoje.weekday === 7;\n\n// Pega o resultado do nó do Supabase\nconst dadosFeriado = $input.all().map(item => item.json);\n\n// Checa se encontrou algum feriado válido no banco hoje\nconst isFeriado = dadosFeriado.length > 0 && dadosFeriado[0].nome !== undefined;\n\nconst pausarHoje = isDomingo || isFeriado;\n\nreturn {\n  json: {\n    hoje: hoje.toFormat('yyyy-MM-dd'),\n    isDomingo: isDomingo,\n    isFeriado: isFeriado,\n    nomeFeriado: isFeriado ? `${dadosFeriado[0].nome} (${dadosFeriado[0].escopo})` : \"Nenhum\",\n    is_dia_util: !pausarHoje\n  }\n};"
      },
      "name": "Verificar Feriado e Domingo",
