    {
      "parameters": {
        "jsCode": "const agoraUTC = new Date();\nconst agoraBR = new Date(agoraUTC.toLocaleString(\"en-US\", { timeZone: \"America/Sao_Paulo\" }));\n\nconst lembretes = [];\n\nfor (const item of $input.all()) {\n  if (!item.json.data_reuniao || !item.json.whatsapp) continue;\n\n  const dataReuniaoUTC = new Date(item.json.data_reuniao);\n  const dataReuniaoBR = new Date(dataReuniaoUTC.toLocaleString(\"en-US\", { timeZone: \"America/Sao_Paulo\" }));\n\n  // Math.round evita que milissegundos de atraso do servidor pulem a janela de disparo\n  const diffMinutos = Math.round((dataReuniaoUTC.getTime() - agoraUTC.getTime()) / 60000);\n\n  // Ignora reuniões que já passaram\n  if (diffMinutos <= 0) continue;\n\n  const isHoje = dataReuniaoBR.toDateString() === agoraBR.toDateString();\n  const horaAtual = agoraBR.getHours();\n  const minutoAtual = agoraBR.getMinutes();\n\n  // 1. Prioridade 10m e 1h (Intervalos semiabertos '>' e '<=' evitam envio duplo)\n  if (diffMinutos > 5 && diffMinutos <= 15) {\n    item.json.tipo_lembrete = \"10m\";\n    lembretes.push(item);\n  } \n  else if (diffMinutos > 55 && diffMinutos <= 65) {\n    item.json.tipo_lembrete = \"1h\";\n    lembretes.push(item);\n  } \n  // 2. Lembrete MATINAL configurado para 7h (Só envia se faltar mais de 75 min pra reunião)\n  else if (isHoje && horaAtual === 7 && minutoAtual < 10 && diffMinutos > 75) {\n    item.json.tipo_lembrete = \"7h\";\n    lembretes.push(item);\n  }\n}\n\nreturn lembretes;"
      },
